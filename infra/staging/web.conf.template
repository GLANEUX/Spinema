# Staging "web" container: same pages as infra/nginx/web.conf.template, behind an access code.
# Nginx asks the "gate" service (infra/staging/gate) whether the cookie is valid; without it,
# the visitor gets the code form, then comes back to the page they asked for.
server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off;
  # Security headers (PLAN.md §8 Sécurité). HSTS is added by the server's Nginx, which does HTTPS.
  # no-referrer: invitation links carry a code that must not leak to other sites.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  # Relative redirects: the server Nginx in front does HTTPS.
  absolute_redirect off;

  auth_request /_gate/check;
  error_page 401 = @login;
  add_header X-Robots-Tag "noindex, nofollow" always;

  # Public: Android checks this file to open invitation links in the app.
  location = /.well-known/assetlinks.json {
    auth_request off;
    default_type application/json;
  }
  location = /style.css {
    auth_request off;
  }
  # Google Play needs these two pages reachable without the access code.
  location ^~ /confidentialite/ {
    auth_request off;
  }
  location ^~ /suppression-compte/ {
    auth_request off;
  }
  location = /robots.txt {
    auth_request off;
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  location = /_gate/check {
    internal;
    proxy_pass http://gate:8080/_gate/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
  }
  location /_gate/ {
    auth_request off;
    proxy_pass http://gate:8080;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
  }
  location @login {
    return 302 /_gate/login?next=$request_uri;
  }

  # try_files runs after the access check ("return" alone would run before it).
  location = /spinema.apk {
    try_files /nonexistent @apk;
  }
  location @apk {
    return 302 ${APK_URL};
  }
  location /i/ {
    try_files $uri /i/index.html;
  }
  location / {
    try_files $uri $uri/ =404;
  }
}
