# Copier en .env puis remplir. Ne jamais commiter le .env.

# --- Base de données ---
POSTGRES_USER=spinema
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=spinema
# Pour lancer l'API hors Docker (pnpm dev) : la base exposée par docker-compose.dev.yml
DATABASE_URL=postgres://spinema:change-moi@localhost:5432/spinema

# --- API ---
API_PORT=3000
LOG_LEVEL=info
# Origines autorisées (page d'invitation), séparées par des virgules
CORS_ORIGINS=http://localhost:8080

# --- App mobile (lu au build par Expo) ---
# Émulateur Android : http://10.0.2.2:3000 · téléphone sur le même Wi-Fi : http://<IP du PC>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# --- Plus tard (étapes 2 à 7) ---
# TMDB_API_KEY=
# BETTER_AUTH_SECRET=
# SMTP_HOST=smtp-relay.brevo.com
