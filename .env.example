# Copier en .env puis remplir. Ne jamais commiter le .env.

# --- Base de données ---
POSTGRES_USER=spinema
POSTGRES_PASSWORD=
POSTGRES_DB=spinema
# Pour lancer l'API hors Docker (pnpm dev) : la base exposée par docker-compose.dev.yml
DATABASE_URL=postgres://spinema:<mot-de-passe>@localhost:5432/spinema

# --- API ---
API_PORT=3000
LOG_LEVEL=info
# Origines autorisées (page d'invitation), séparées par des virgules
CORS_ORIGINS=http://localhost:8080

# Adresse sur laquelle Docker publie l'API. 0.0.0.0 pour la tester depuis un téléphone
# sur le même Wi-Fi ; garder 127.0.0.1 sur le serveur (le Nginx fait le relais).
API_BIND=127.0.0.1

# L'adresse de l'API vue par l'app se règle dans apps/mobile/.env (voir apps/mobile/.env.example).

# --- Plus tard (étapes 2 à 7) ---
