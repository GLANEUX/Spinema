# Copier en .env puis remplir. Ne jamais commiter le .env.

# --- Base de données ---
POSTGRES_USER=spinema
POSTGRES_PASSWORD=
POSTGRES_DB=spinema
# Pour lancer l'API hors Docker (pnpm dev) : la base exposée par docker-compose.dev.yml
DATABASE_URL=postgres://spinema:<mot-de-passe>@localhost:5432/spinema

# --- API ---
API_PORT=3000
LOG_LEVEL=info
# Origines autorisées (page d'invitation), séparées par des virgules
CORS_ORIGINS=http://localhost:8080

# Adresse sur laquelle Docker publie l'API. 0.0.0.0 pour la tester depuis un téléphone
# sur le même Wi-Fi ; garder 127.0.0.1 sur le serveur (le Nginx fait le relais).
API_BIND=127.0.0.1

# Nombre de proxys devant l'API (1 derrière le Nginx du serveur, 0 en local) : les limites de
# requêtes comptent alors l'adresse du visiteur, pas celle du proxy.
TRUST_PROXY=0

# L'adresse de l'API vue par l'app se règle dans apps/mobile/.env (voir apps/mobile/.env.example).

# --- E-mails ---
# Sans SMTP_HOST, les e-mails sont écrits dans les logs de l'API.
# Avec Docker en local : Mailpit, déjà branché dans docker-compose.yml (e-mails visibles sur
# http://127.0.0.1:8025). API lancée hors Docker avec docker-compose.dev.yml : SMTP_HOST=localhost
# et SMTP_PORT=1025. Sur les serveurs : Brevo (SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Spinema <noreply@spinema.fr>"

# --- Plus tard (étapes suivantes) ---
# TMDB_API_KEY=
# BETTER_AUTH_SECRET=
