# Copier en apps/mobile/.env. Expo lit ce fichier au démarrage (pnpm --filter @spinema/mobile start).
# Émulateur Android : http://10.0.2.2:3000
# Téléphone sur le même Wi-Fi : http://<IP Wi-Fi du PC>:3000 (sous Windows : ipconfig, ligne « Adresse IPv4 » de la carte Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
